<Window x:Class="Cl4nLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="764 CL4N" Width="800" Height="640" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#090B12" FontFamily="Segoe UI" Foreground="#DFE3EE"
        AllowsTransparency="False">
  <Window.Resources>
    <SolidColorBrush x:Key="Acc" Color="#E5333F"/>
    <SolidColorBrush x:Key="Acc2" Color="#8B0F1A"/>

    <!-- ===== кнопки меню: лёгкий 3D-наклон/подъём при наведении ===== -->
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
      <Setter Property="RenderTransform">
        <Setter.Value>
          <TransformGroup>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
            <TranslateTransform X="0" Y="0"/>
          </TransformGroup>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" ClipToBounds="False">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.92"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
              <EventTrigger RoutedEvent="Button.MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="6" Duration="0:0:0.15"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="Button.MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetProperty="(Button.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="RenderTransform">
        <Setter.Value>
          <TransformGroup><ScaleTransform ScaleX="1" ScaleY="1"/><TranslateTransform X="0" Y="0"/></TransformGroup>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C42B1C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Acc}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- мягкое появление всего окна -->
    <Storyboard x:Key="Intro">
      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
    </Storyboard>
  </Window.Resources>

  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource Intro}"/>
    </EventTrigger>
  </Window.Triggers>

  <Grid x:Name="Root" Opacity="0">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B0E18" Offset="0"/><GradientStop Color="#080A10" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>

    <Grid.RowDefinitions>
      <RowDefinition Height="28"/><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="96"/>
    </Grid.RowDefinitions>

    <!-- фоновые объёмные пятна (создают ощущение глубины за контентом) -->
    <Canvas Grid.RowSpan="4" IsHitTestVisible="False">
      <Ellipse x:Name="BlobA" Width="420" Height="420" Canvas.Right="-120" Canvas.Top="60" Opacity="0.22">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#E5333F" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse x:Name="BlobB" Width="340" Height="340" Canvas.Left="-100" Canvas.Top="260" Opacity="0.16">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#3C64C8" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Canvas>


    <!-- шапка окна -->
    <Border Grid.Row="0" Background="#04060C" MouseLeftButtonDown="Drag">
      <Grid>
        <TextBlock Text="764 CL4N" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
        <Button Style="{StaticResource CloseBtn}" Content="✕" Foreground="White" FontSize="15" Width="44" HorizontalAlignment="Right" Click="Close_Click"/>
      </Grid>
    </Border>

    <!-- логотип (настоящий вращающийся 3D) и ник -->
    <Border Grid.Row="1" BorderThickness="0,0,0,2" BorderBrush="{StaticResource Acc}" MouseLeftButtonDown="Drag">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0C1220" Offset="0"/><GradientStop Color="#0A0F1B" Offset="1"/></LinearGradientBrush>
      </Border.Background>
      <Grid Margin="28,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="54" Height="54" Margin="0,0,16,0">
            <Viewport3D Width="54" Height="54">
              <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0,2.3" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="40"/>
              </Viewport3D.Camera>
              <ModelVisual3D>
                <ModelVisual3D.Content>
                  <Model3DGroup>
                    <AmbientLight Color="#9A9A9A"/>
                    <DirectionalLight Color="#FFFFFF" Direction="-0.4,-0.25,-1"/>
                    <DirectionalLight Color="#552230" Direction="0.6,0.3,0.4"/>
                    <GeometryModel3D>
                      <GeometryModel3D.Geometry>
                        <MeshGeometry3D
                          Positions="-1,-1,0 1,-1,0 1,1,0 -1,1,0"
                          TextureCoordinates="0,1 1,1 1,0 0,0"
                          TriangleIndices="0,1,2 0,2,3"/>
                      </GeometryModel3D.Geometry>
                      <GeometryModel3D.Material>
                        <DiffuseMaterial>
                          <DiffuseMaterial.Brush>
                            <ImageBrush ImageSource="logo.png" Stretch="Uniform"/>
                          </DiffuseMaterial.Brush>
                        </DiffuseMaterial>
                      </GeometryModel3D.Material>
                      <GeometryModel3D.Transform>
                        <RotateTransform3D>
                          <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D x:Name="LogoSpin" Axis="0,1,0.12" Angle="0"/>
                          </RotateTransform3D.Rotation>
                        </RotateTransform3D>
                      </GeometryModel3D.Transform>
                    </GeometryModel3D>
                  </Model3DGroup>
                </ModelVisual3D.Content>
              </ModelVisual3D>
            </Viewport3D>
          </Border>
          <TextBlock FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center">
            <Run Text="764 "/><Run Text="CL4N" Foreground="{StaticResource Acc}"/>
          </TextBlock>
        </StackPanel>
        <Button Style="{StaticResource Flat}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#DFE3EE" Click="Nick_Click" ToolTip="Сменить ник" HorizontalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="8,4">
            <TextBlock x:Name="NickText" Text="Гость" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Acc}">
              <TextBlock x:Name="NickInit" Text="?" FontWeight="Bold" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- меню и описание -->
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="Tabs" Grid.Column="0" Margin="34,10,0,0">
        <TextBlock Text="Меню" Style="{StaticResource Head}"/>
        <Button Style="{StaticResource Flat}" Tag="site" Content="Сайт клана" Click="Tab_Click" HorizontalContentAlignment="Left" FontSize="17" Padding="0,8"/>
        <Button Style="{StaticResource Flat}" Tag="roster" Content="Состав" Click="Tab_Click" HorizontalContentAlignment="Left" FontSize="17" Padding="0,8"/>
        <Button Style="{StaticResource Flat}" Tag="apply" Content="Заявка" Click="Tab_Click" HorizontalContentAlignment="Left" FontSize="17" Padding="0,8"/>
        <Button Style="{StaticResource Flat}" Tag="dc" Content="Discord" Click="Tab_Click" HorizontalContentAlignment="Left" FontSize="17" Padding="0,8"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="20,10,34,0">
        <TextBlock Text="Описание" Style="{StaticResource Head}"/>
        <TextBlock x:Name="Desc" TextWrapping="Wrap" FontSize="15" LineHeight="22" Margin="0,0,0,26"/>
        <TextBlock x:Name="LogHead" Text="Список изменений" Style="{StaticResource Head}"/>
        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#C9CEDC"
                   Text="— Нативное приложение вместо страницы в браузере&#10;— Проверка связи с сервером клана перед запуском&#10;— Быстрый переход к составу, заявке и Discord&#10;— Ник сохраняется на этом компьютере"/>
      </StackPanel>
      <Border x:Name="NickPanel" Grid.ColumnSpan="2" Background="#F2090B12" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Твой ник" Style="{StaticResource Head}" HorizontalAlignment="Center"/>
          <TextBox x:Name="NickBox" Width="260" MaxLength="20" FontSize="16" Padding="8,6" Background="#10131D" Foreground="White" BorderBrush="#2A2F40"/>
          <Button Style="{StaticResource Flat}" Content="Сохранить" Background="{StaticResource Acc}" Foreground="White" FontWeight="Bold" Height="40" Width="260" Margin="0,12,0,0" Click="NickOk_Click" HorizontalContentAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- статус и кнопка -->
    <Grid Grid.Row="3" Margin="34,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="S1" Text="Подключение…" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="S2" Text="Статус: —" FontSize="14" Foreground="#9AA2B8" Margin="0,4,0,0"/>
      </StackPanel>
      <Button x:Name="Go" Grid.Column="1" Style="{StaticResource Flat}" Height="56" Click="Go_Click" HorizontalContentAlignment="Stretch">
        <Button.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F04452" Offset="0"/>
            <GradientStop Color="#C22430" Offset="1"/>
          </LinearGradientBrush>
        </Button.Background>
        <Grid>
          <Rectangle x:Name="Fill" HorizontalAlignment="Stretch" Fill="White" Opacity="0.2" RenderTransformOrigin="0,0.5">
            <Rectangle.RenderTransform><ScaleTransform x:Name="FillScale" ScaleX="0"/></Rectangle.RenderTransform>
          </Rectangle>
          <TextBlock x:Name="GoText" Text="Подождите…" FontSize="19" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Button>
    </Grid>
  </Grid>
</Window>
